{
  "name": "nexus-warfare",
  "version": "1.0.0",
  "description": "Realistic mobile-first multiplayer 3D combat game",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "build": "npm run build:shared && npm run build:client && npm run build:server",
    "build:shared": "cd shared && npm run build",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "start": "cd server && npm start",
    "setup": "npm install && cd services/matchmaking && pip install -r requirements.txt",
    "test": "npm run test:server && npm run test:services",
    "test:server": "cd server && npm test",
    "test:services": "cd services/matchmaking && python -m pytest",
    "download-assets": "bash scripts/download-assets.sh",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "typescript": "^5.3.0",
    "eslint": "^8.50.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0"
  }
}
